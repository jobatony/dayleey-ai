# ==============================================================================
# Dayleey AI – AWS Production Environment Template
# Copy to .env.prod on your EC2 server (chmod 600 .env.prod). NEVER commit .env.prod.
# ==============================================================================

# --- Domain & Django Core ---
DOMAIN=api.yourdomain.com
DJANGO_SETTINGS_MODULE=dayleey.settings.prod
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-at-least-64-char-random-secret-key
ALLOWED_HOSTS=api.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
# Custom admin path for security (visit https://api.yourdomain.com/<ADMIN_URL>)
ADMIN_URL=ops-dayleey-admin/
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True

# --- Database (Amazon RDS PostgreSQL recommended) ---
# Format: postgres://<user>:<password>@<rds-endpoint>:5432/<dbname>?sslmode=require
DATABASE_URL=postgres://dayleey:CHANGE_ME@dayleey-db.xxxxxxxxxxxx.eu-west-1.rds.amazonaws.com:5432/dayleey?sslmode=require

# If deploying single-EC2 budget DB (--profile localdb), uncomment below instead of RDS:
# POSTGRES_DB=dayleey
# POSTGRES_USER=dayleey
# POSTGRES_PASSWORD=replace-with-strong-db-password
# DATABASE_URL=postgres://dayleey:replace-with-strong-db-password@postgres:5432/dayleey

# --- WhatsApp Transport (Official Meta Cloud API) ---
WA_TRANSPORT=cloud_api
WA_DRY_RUN=False
PAUSE_ALL=False
WA_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=your-meta-phone-number-id
WA_BOT_PHONE_NUMBER=2348000000000
WA_ACCESS_TOKEN=your-permanent-system-user-token
WA_VERIFY_TOKEN=replace-with-long-random-verify-token
WA_APP_SECRET=your-meta-app-secret

# --- Bot UX & Budget Guardrails ---
BOT_DISPLAY_NAME=Dayleey
DEFAULT_TIMEZONE=Africa/Lagos
PARTNER_FALLBACK_DAYS=3
QUIET_HOURS_START=22
QUIET_HOURS_END=6
WEEKLY_REPORT_ENABLED=False
BETA_ALLOWLIST_ENABLED=True

# Update NG rates from Meta's official WhatsApp rate card before launch
MONTHLY_BUDGET_USD=25.00
FREE_SERVICE_MESSAGES_PER_MONTH=1000
USER_MONTHLY_MSG_CAP=350
USER_DAILY_MSG_LIMIT=10
PARTNER_DAILY_MSG_LIMIT=2
RATE_CARD_JSON={"default":{"service":0.0050,"utility":0.0068,"marketing":0.0250},"NG":{"service":0.0050,"utility":0.0068,"marketing":0.0250}}

# --- Observability ---
SENTRY_DSN=

# --- Optional: Temporary Baileys Sidecar on AWS (--profile baileys) ---
# Switch WA_TRANSPORT=baileys above and set these to run Baileys temporarily on EC2:
# BRIDGE_SECRET=replace-with-long-random-bridge-secret
# BRIDGE_URL=http://bridge:3001
# BAILEYS_ALLOWLIST=2347025133613,2348147611480
# Headless 8-digit linking code (dedicated bot SIM digits, no +) so you don't need QR in Docker logs:
# WA_PAIRING_PHONE=2349022603655
