# Django
DJANGO_SETTINGS_MODULE=dayleey.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.onrender.com,.up.railway.app

# Database (leave blank locally to use SQLite; set Postgres URL in prod e.g. Neon/Supabase)
DATABASE_URL=

# WhatsApp Transport: dry_run | cloud_api | baileys
WA_TRANSPORT=dry_run
WA_DRY_RUN=True
PAUSE_ALL=False
DJANGO_Q_SYNC=True

# WhatsApp Cloud API (Meta)
WA_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_BOT_PHONE_NUMBER=2348000000000
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=dayleey-verify-token
WA_APP_SECRET=dev-app-secret

# Baileys Prototype Sidecar (used only when WA_TRANSPORT=baileys)
BRIDGE_SECRET=change-me-bridge-secret
BRIDGE_URL=http://127.0.0.1:3001
DJANGO_INBOUND_URL=http://127.0.0.1:8000/bridge/inbound/
# Comma-separated digits only (no +), e.g. 2348011111111,2348022222222 (max 5 testers)
BAILEYS_ALLOWLIST=
# Optional: set dedicated bot phone digits (no +) to link via 8-digit pairing code instead of QR
WA_PAIRING_PHONE=

# Bot Identity & UX Defaults
BOT_DISPLAY_NAME=Dayleey
PARTNER_FALLBACK_DAYS=3
QUIET_HOURS_START=22
QUIET_HOURS_END=6
WEEKLY_REPORT_ENABLED=False
BETA_ALLOWLIST_ENABLED=False

# Budget & Rate Card (update Nigeria/Rest of Africa rates from Meta's rate card before launch)
MONTHLY_BUDGET_USD=25.00
FREE_SERVICE_MESSAGES_PER_MONTH=1000
USER_MONTHLY_MSG_CAP=350
USER_DAILY_MSG_LIMIT=10
PARTNER_DAILY_MSG_LIMIT=2
RATE_CARD_JSON={"default":{"service":0.0050,"utility":0.0068,"marketing":0.0250},"NG":{"service":0.0050,"utility":0.0068,"marketing":0.0250}}

# Observability (optional)
SENTRY_DSN=
